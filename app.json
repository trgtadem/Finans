{
  "expo": {
    "name": "Finans",
    "slug": "Finans",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "finans",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2D6CDF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.finans.android",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Finans uygulamasını güvenli şekilde açmak için Face ID kullanılır."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2D6CDF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.finans.android",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2D6CDF",
          "sounds": []
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Finans uygulamasını güvenli şekilde açmak için Face ID kullanılır."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#2D6CDF"
    }
  }
}
