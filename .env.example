# Kopyalayın: cp .env.example .env
# Expo yeniden başlatın: npx expo start --clear

# Firebase App Check — Debug token (Firebase Console → App Check → Manage debug tokens)
EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=your-debug-token-uuid

# Üretim build için (debug token yerine)
# EXPO_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key
